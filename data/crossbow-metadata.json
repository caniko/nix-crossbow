  "buildOptimizationProfiles": {
    "cache-first": {
      "name": "cache-first",
      "changesHashes": false,
      "cFlags": [],
      "linkFlags": [],
      "rustFlags": [],
      "goFlags": [],
      "goLdflags": [],
      "goEnv": {},
      "description": "Preserve nixpkgs derivation hashes and maximize binary cache reuse."
    },
    "fast-local": {
      "name": "fast-local",
      "changesHashes": true,
      "cFlags": [
        "-flto=thin"
      ],
      "linkFlags": [
        "-fuse-ld=mold"
      ],
      "rustFlags": [
        "-C",
        "lto=thin",
        "-C",
        "link-arg=-fuse-ld=mold"
      ],
      "goFlags": [
        "-trimpath"
      ],
      "goLdflags": [
        "-s",
        "-w"
      ],
      "goEnv": {
        "CGO_ENABLED": "0"
      },
      "description": "Use local build accelerators for derivations that are not expected to substitute."
    }
  }
